    "subgraphs": [
      {"name": "SNAP_Small", "nodes": 100},
      {"name": "SNAP_Medium", "nodes": 250},
      {"name": "SNAP_Large", "nodes": 500},
      {"name": "SNAP_XLarge", "nodes": 1000}
